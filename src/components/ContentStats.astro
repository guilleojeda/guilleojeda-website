---
import type { Locale } from '../content/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'en'
  ? {
      title: 'Statistics',
      overviewScope: 'All content languages · Covered sources',
      overviewLoading: 'Loading…',
      overviewLabels: {
        articles: 'Published articles',
        talks: 'Delivered talks & sessions',
        books: 'Published books',
        newsletter: 'Current Simple AWS subscribers'
      },
      reportSummary: 'Explore statistics',
      catalogLink: 'Browse the article catalog',
      filterLabel: 'Content language',
      periodLabel: 'Activity period',
      all: 'All',
      english: 'English',
      spanish: 'Español',
      periods: {
        '7d': 'Last 7 days',
        '30d': 'Last 30 days',
        '90d': 'Last 90 days',
        '12m': 'Last 12 months',
        ytd: 'Year to date',
        total: 'Recorded total'
      },
      cumulative: 'Total',
      currentSubscribers: 'Current active subscribers',
      newsletterSent: {
        label: 'Emails sent · cumulative total',
        unit: 'emails',
        loading: 'Loading emails sent…',
        unavailable: 'Emails sent are unavailable.'
      },
      coverage: 'Coverage',
      lastCollected: 'Last updated',
      metadataSummary: 'Source & dates',
      viewsTitle: 'Simple AWS page views',
      viewsLoading: 'Loading page views…',
      viewsUnavailable: 'Page view data are unavailable.',
      viewsUnit: 'views',
      viewsCoverage: 'Coverage',
      viewsInterval: 'Reporting interval',
      viewsCollected: 'Last updated',
      builderViews: {
        title: 'Builder Center views · recorded total',
        loading: 'Loading Builder Center recorded views…',
        unavailable: 'Builder Center recorded views are unavailable.',
        unit: 'views',
        coverage: 'Source',
        since: 'Tracking starts',
        observed: 'Observation date',
        provenance: 'Provenance',
        automaticProvenance: 'Automatically observed · historical',
        manualProvenance: 'Manually maintained'
      },
      searchTitle: 'Google Search clicks · Simple AWS',
      searchLoading: 'Loading Search clicks…',
      searchUnavailable: 'Search click data are unavailable.',
      searchUnit: 'clicks',
      searchCoverage: 'Coverage',
      searchInterval: 'Reporting interval',
      searchCollected: 'Last updated',
      noScript: 'Enable JavaScript to view these statistics.',
      cards: {
        articles: {
          title: 'Articles',
          unit: 'published articles',
          loading: 'Loading article statistics…',
          unavailable: 'Article statistics are temporarily unavailable.'
        },
        talks: {
          title: 'Talks & sessions',
          unit: 'sessions',
          loading: 'Loading speaking statistics…',
          unavailable: 'Speaking statistics are temporarily unavailable.'
        },
        books: {
          title: 'Books',
          unit: 'published books',
          loading: 'Loading book statistics…',
          unavailable: 'Book statistics are temporarily unavailable.'
        },
        newsletter: {
          title: 'Simple AWS newsletter',
          unit: 'active subscribers',
          loading: 'Loading newsletter statistics…',
          unavailable: 'Newsletter statistics are temporarily unavailable.'
        }
      },
      directoryViews: {
        title: 'Dónde Aprendo AWS',
        loading: 'Loading Dónde Aprendo AWS page views…',
        unavailable: 'Dónde Aprendo AWS page view data are unavailable.',
        unit: 'page views'
      },
      directoryOutboundClicks: {
        title: 'External link clicks',
        loading: 'Loading Dónde Aprendo AWS external link clicks…',
        unavailable: 'Dónde Aprendo AWS external link click data are unavailable.',
        unit: 'clicks',
        interval: 'Reporting interval',
        collected: 'Last updated'
      },
      sourcesSummary: 'How these figures are counted',
      privacyLink: 'Privacy and use',
      emailActivity: {
        opens: {
          label: 'Email opens',
          unit: 'opens',
          loading: 'Loading email opens…',
          unavailable: 'Email open data are unavailable.'
        },
        verifiedClicks: {
          label: 'Verified email clicks',
          unit: 'clicks',
          loading: 'Loading verified email clicks…',
          unavailable: 'Verified email click data are unavailable.'
        },
        interval: 'Reporting interval',
        collected: 'Last updated'
      },
      sourcesExplanation: [
        'Article counts combine automatically updated registered sources—Caylent, AWS Builder Center, Simple AWS, Cloudy Things, Dónde Aprendo AWS and AWS for Engineers—with individually selected articles from DEV Community, LinkedIn, SpainClouds and HackerNoon. Mixed platforms are not imported in full; personal writing and promotions without substantive content are excluded, while professional AWS guides remain included. Simple AWS includes posts published on the web, by email or both; Cloudy Things may add originals and republications. Translations count by content language: matching titles in one language count once across sources; different titles and translations count separately. “All” includes both languages.',
        'Talks & sessions count delivered talks, workshops, training, panels and technical sessions; repeat deliveries at separate events count again. Host-only appearances, commentary, podcasts, conversations and upcoming sessions are excluded.',
        'Books count published titles, including historical books whose current source is unavailable; books in progress are excluded. Talk and book languages follow their original titles.',
        'Simple AWS page views cover only newsletter publication pages, a partial coverage compared with article counts. Views can repeat for one reader; reports may be delayed or revised.',
        'Builder Center’s recorded total covers views of this author’s articles currently published there; views include republications and translations even when matching titles count as one article. Tracking began January 6, 2026, excludes the author’s own visits, and counts one visit per reader per article every 24 hours; a later return can count again. New totals are maintained manually, and the displayed date is the actual observation date; the retained earlier total is labeled as a historical automatic observation. Earlier activity or tracking gaps may be missing, and source corrections or publication changes can revise the total. It is independent of the selected period and is not a complete lifetime total or a count of unique readers.',
        'Google Search Console clicks cover canonical or Google-preferred Simple AWS article URLs. Reporting limits may omit clicks; they are not unique readers, may be delayed or revised, and remain separate from Analytics page views.',
        'Dónde Aprendo AWS page views cover the full directory and can repeat for one person; they are separate from article views. Reports may be delayed or revised.',
        'Recorded traffic totals include only activity available since the start date shown under Source & dates; earlier activity or tracking gaps may be missing. View reports can be delayed or revised.',
        'External-link clicks recorded for Dónde Aprendo AWS cover links to the publication and social channels throughout the directory, including the footer. One person can click more than once; clicks are separate from directory views and incoming Search clicks.',
        'Email opens are tracking-pixel events: privacy protections and automated loads can count as opens, while some reads may not register.',
        'Verified email clicks are Beehiiv-filtered events; they can repeat and do not represent unique people or guarantee a human click. Email figures cover history returned by Beehiiv, so tracking gaps may omit activity and reported values can change later.',
        'Emails sent are Beehiiv’s reported cumulative total; one person may receive multiple emails. The available history returned by Beehiiv may be incomplete; tracking gaps can leave activity missing and the reported total can change. It does not follow the selected period.',
        'Simple AWS is an English newsletter; the subscriber figure counts current active subscriptions.',
      ]
    }
  : {
      title: 'Estadísticas',
      overviewScope: 'Todos los idiomas de contenido · Cobertura parcial',
      overviewLoading: 'Cargando…',
      overviewLabels: {
        articles: 'Artículos publicados',
        talks: 'Charlas y sesiones realizadas',
        books: 'Libros publicados',
        newsletter: 'Suscriptores actuales de Simple AWS'
      },
      reportSummary: 'Explorar estadísticas',
      catalogLink: 'Explorar el catálogo de artículos',
      filterLabel: 'Idioma del contenido',
      periodLabel: 'Período de actividad',
      all: 'Todos',
      english: 'English',
      spanish: 'Español',
      periods: {
        '7d': 'Últimos 7 días',
        '30d': 'Últimos 30 días',
        '90d': 'Últimos 90 días',
        '12m': 'Últimos 12 meses',
        ytd: 'Año hasta la fecha',
        total: 'Total registrado'
      },
      cumulative: 'Total',
      currentSubscribers: 'Suscriptores actuales',
      newsletterSent: {
        label: 'Emails enviados · total acumulado',
        unit: 'emails',
        loading: 'Cargando emails enviados…',
        unavailable: 'No se pueden mostrar los emails enviados.'
      },
      coverage: 'Cobertura',
      lastCollected: 'Última actualización',
      metadataSummary: 'Fuente y fechas',
      viewsTitle: 'Vistas de páginas de Simple AWS',
      viewsLoading: 'Cargando vistas de páginas…',
      viewsUnavailable: 'Datos de vistas de páginas: no disponibles.',
      viewsUnit: 'vistas',
      viewsCoverage: 'Cobertura',
      viewsInterval: 'Intervalo informado',
      viewsCollected: 'Última actualización',
      builderViews: {
        title: 'Vistas en Builder Center · total registrado',
        loading: 'Cargando vistas registradas de Builder Center…',
        unavailable: 'Las vistas registradas de Builder Center no están disponibles.',
        unit: 'vistas',
        coverage: 'Fuente',
        since: 'Inicio del registro',
        observed: 'Fecha de observación',
        provenance: 'Procedencia',
        automaticProvenance: 'Observación automática · histórica',
        manualProvenance: 'Mantenimiento manual'
      },
      searchTitle: 'Clics de búsqueda de Google · Simple AWS',
      searchLoading: 'Cargando clics de búsqueda…',
      searchUnavailable: 'Datos de clics de búsqueda: no disponibles.',
      searchUnit: 'clics',
      searchCoverage: 'Cobertura',
      searchInterval: 'Intervalo informado',
      searchCollected: 'Última actualización',
      noScript: 'Activa JavaScript para ver estas estadísticas.',
      cards: {
        articles: {
          title: 'Artículos',
          unit: 'artículos publicados',
          loading: 'Cargando estadísticas de artículos…',
          unavailable: 'No se pueden cargar las estadísticas de artículos por el momento.'
        },
        talks: {
          title: 'Charlas y sesiones',
          unit: 'sesiones',
          loading: 'Cargando estadísticas de sesiones…',
          unavailable: 'Las estadísticas de sesiones no están disponibles por el momento.'
        },
        books: {
          title: 'Libros',
          unit: 'libros publicados',
          loading: 'Cargando estadísticas de libros…',
          unavailable: 'Las estadísticas de libros no están disponibles por el momento.'
        },
        newsletter: {
          title: 'Boletín Simple AWS',
          unit: 'suscriptores activos',
          loading: 'Cargando estadísticas del boletín…',
          unavailable: 'Las estadísticas del boletín no están disponibles por el momento.'
        }
      },
      directoryViews: {
        title: 'Dónde Aprendo AWS',
        loading: 'Cargando vistas de página de Dónde Aprendo AWS…',
        unavailable: 'Datos de vistas de páginas de Dónde Aprendo AWS: no disponibles.',
        unit: 'vistas de página'
      },
      directoryOutboundClicks: {
        title: 'Clics en enlaces externos',
        loading: 'Cargando clics en enlaces externos de Dónde Aprendo AWS…',
        unavailable: 'Datos de clics en enlaces externos de Dónde Aprendo AWS: no disponibles.',
        unit: 'clics',
        interval: 'Intervalo informado',
        collected: 'Última actualización'
      },
      sourcesSummary: 'Cómo se cuentan estas cifras',
      privacyLink: 'Privacidad y uso',
      emailActivity: {
        opens: {
          label: 'Aperturas de emails',
          unit: 'aperturas',
          loading: 'Cargando aperturas de emails…',
          unavailable: 'Datos de aperturas de emails: no disponibles.'
        },
        verifiedClicks: {
          label: 'Clics verificados en emails',
          unit: 'clics',
          loading: 'Cargando clics verificados en emails…',
          unavailable: 'Datos de clics verificados en emails: no disponibles.'
        },
        interval: 'Intervalo informado',
        collected: 'Última actualización'
      },
      sourcesExplanation: [
        'El conteo de artículos combina fuentes registradas que se actualizan automáticamente —Caylent, AWS Builder Center, Simple AWS, Cloudy Things, Dónde Aprendo AWS y AWS for Engineers— con artículos seleccionados individualmente de DEV Community, LinkedIn, SpainClouds y HackerNoon. No se importan completas las plataformas mixtas; se cuentan solo los artículos aprobados individualmente. Se excluyen los textos personales y la promoción sin contenido sustantivo, mientras que se incluyen las guías profesionales sobre AWS. Simple AWS incluye publicaciones difundidas en la web, por email o en ambos medios; Cloudy Things puede aportar originales y republicaciones. Las traducciones se cuentan según su idioma: los títulos iguales en un mismo idioma cuentan una vez entre fuentes; los títulos distintos y las traducciones cuentan por separado. “Todos” incluye ambos idiomas.',
        'Charlas y sesiones cuentan charlas, workshops, capacitaciones, paneles y sesiones técnicas realizadas; las entregas repetidas en eventos distintos vuelven a contar. Se excluyen apariciones solo como anfitrión, comentarios, podcasts, conversaciones y sesiones futuras.',
        'Los libros cuentan títulos publicados, incluidos libros históricos cuya fuente actual no está disponible; se excluyen los libros en preparación. El idioma de las charlas y los libros se determina por sus títulos originales.',
        'Las vistas de páginas de Simple AWS cubren solo las páginas de publicación del boletín; es una cobertura parcial frente al conteo de artículos. Una persona puede generar varias vistas; los informes pueden tener demora o revisarse.',
        'El total registrado de Builder Center cubre vistas de los artículos de este autor publicados actualmente allí; las vistas incluyen republicaciones y traducciones aunque los títulos coincidentes cuenten como un solo artículo. El seguimiento comenzó el 6 de enero de 2026, excluye las visitas propias del autor y cuenta una visita por lector y artículo cada 24 horas; una visita posterior puede volver a contar. Los nuevos totales se mantienen manualmente y la fecha mostrada es la fecha real de observación; el total anterior conservado se identifica como una observación histórica automática. Puede faltar actividad anterior o de períodos sin seguimiento, y las correcciones de la fuente o los cambios en las publicaciones pueden modificar el total. Es independiente del período seleccionado y no representa un total de por vida completo ni lectores únicos.',
        'Google Search Console informa clics de URLs canónicas o preferidas por Google de artículos de Simple AWS. Los límites del informe pueden omitir clics; no representan lectores únicos, pueden tener demora o revisarse y se mantienen separados de las vistas de Analytics.',
        'Las vistas de páginas de Dónde Aprendo AWS cubren el directorio completo y pueden repetirse para una persona; se informan aparte de las vistas de artículos. Los informes pueden tener demora o revisarse.',
        'Los totales de tráfico registrados solo incluyen actividad disponible desde la fecha de inicio indicada en “Fuente y fechas”; puede faltar actividad anterior o de períodos sin seguimiento. Los informes de vistas pueden tener demora o revisarse.',
        'Los clics registrados en enlaces externos de Dónde Aprendo AWS cubren enlaces a la publicación y a redes sociales en todo el directorio, incluido el pie de página. Una persona puede hacer más de un clic; se informan aparte de las vistas del directorio y de las búsquedas entrantes.',
        'Las aperturas de emails son eventos de píxeles de seguimiento: las protecciones de privacidad y las cargas automáticas pueden contarse como aperturas, mientras que algunas lecturas pueden no registrarse.',
        'Los clics verificados en emails son eventos filtrados por Beehiiv; pueden repetirse y no representan personas únicas ni garantizan que una persona haya hecho clic. Las cifras de emails cubren el historial devuelto por Beehiiv, por lo que los períodos sin seguimiento pueden omitir actividad y los valores informados pueden cambiar más adelante.',
        'Los emails enviados son el total acumulado informado por Beehiiv; una persona puede recibir varios emails. El historial disponible devuelto por Beehiiv puede estar incompleto; los períodos sin seguimiento pueden omitir actividad y el total informado puede cambiar. No sigue el período seleccionado.',
        'Simple AWS es un boletín en inglés; la cifra de suscriptores cuenta las suscripciones activas actuales.',
      ]
    };

const cardKinds = ['articles', 'talks', 'books', 'newsletter'] as const;
---

<section
  class="section content-stats"
  id="content-stats"
  aria-labelledby="content-stats-title"
  data-stats-source="/content-stats/v1/current.json"
  data-stats-locale={locale}
>
  <div class="section-shell">
    <div class="section-heading content-stats-heading">
      <h2 id="content-stats-title">{copy.title}</h2>
    </div>

    <div class="content-stats-overview" data-stats-overview aria-labelledby="content-stats-overview-scope" aria-busy="true">
      <p class="content-stats-overview-scope" id="content-stats-overview-scope">{copy.overviewScope}</p>
      <dl class="content-stats-overview-grid">
        {cardKinds.map((kind) => (
          <div class="content-stats-overview-item">
            <dt id={`content-stats-overview-${kind}`}>{copy.overviewLabels[kind]}</dt>
            <dd data-stats-overview-value={kind} data-stats-overview-state="loading" role="status" aria-live="polite" aria-atomic="true" aria-labelledby={`content-stats-overview-${kind}`}>{copy.overviewLoading}</dd>
          </div>
        ))}
      </dl>
    </div>

    <details class="content-stats-report" data-stats-report>
      <summary>{copy.reportSummary}</summary>
      <div class="content-stats-report-content">
        <div class="content-stats-controls">
          <div class="content-stats-control">
            <label for="content-stats-language">{copy.filterLabel}</label>
            <select id="content-stats-language" data-stats-language disabled>
              <option value="all" selected>{copy.all}</option>
              <option value="en">{copy.english}</option>
              <option value="es">{copy.spanish}</option>
            </select>
          </div>
          <div class="content-stats-control">
            <label for="content-stats-period">{copy.periodLabel}</label>
            <select id="content-stats-period" data-stats-period disabled>
              {(['7d', '30d', '90d', '12m', 'ytd', 'total'] as const).map((period) => (
                <option value={period} selected={period === '12m'} disabled={period === 'total'}>{copy.periods[period]}</option>
              ))}
            </select>
          </div>
        </div>

    <div class="content-stats-cards">
      {cardKinds.map((kind) => {
        const card = copy.cards[kind];
        return (
          <article class="content-stats-card" data-stats-kind={kind} data-stats-unavailable={card.unavailable} aria-labelledby={`content-stats-${kind}-title`} aria-busy="false">
            <div class="content-stats-card-heading">
              <div>
                {kind !== 'newsletter' && <div class="work-kicker">{copy.cumulative}</div>}
                <h3 id={`content-stats-${kind}-title`}>{card.title}</h3>
                {kind === 'articles' && (
                  <a class="content-stats-catalog-link" href={locale === 'en' ? '/articles/' : '/es/articles/'}>
                    {copy.catalogLink} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>

            <p class="content-stats-status" data-stats-status role="status" aria-live="polite" hidden>{card.loading}</p>

            <div class="content-stats-results" data-stats-results hidden>
              <p class="content-stats-count" data-stats-count-region role="status" aria-live="polite" aria-atomic="true">
                <span data-stats-count></span>
                <span data-stats-count-label>{kind === 'newsletter' ? copy.currentSubscribers : card.unit}</span>
              </p>

              <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                <dl class="content-stats-meta">
                  <div>
                    <dt>{copy.coverage}</dt>
                    <dd data-stats-coverage></dd>
                  </div>
                  <div>
                    <dt>{copy.lastCollected}</dt>
                    <dd data-stats-collected-date></dd>
                  </div>
                </dl>
              </details>

            </div>

            {kind === 'newsletter' && (
              <>
                <div
                  class="content-stats-newsletter-sent"
                  data-stats-newsletter-sent
                  data-stats-newsletter-sent-unavailable={copy.newsletterSent.unavailable}
                  aria-labelledby="content-stats-newsletter-sent-title"
                >
                  <h4 class="content-stats-newsletter-sent-heading" id="content-stats-newsletter-sent-title">
                    {copy.newsletterSent.label}
                  </h4>
                  <p class="content-stats-newsletter-sent-status" data-stats-newsletter-sent-status role="status" aria-live="polite" hidden>
                    {copy.newsletterSent.loading}
                  </p>
                  <div class="content-stats-newsletter-sent-results" data-stats-newsletter-sent-results hidden>
                    <p class="content-stats-newsletter-sent-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-sent-value></span>
                      <span>{copy.newsletterSent.unit}</span>
                    </p>
                    <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                      <dl class="content-stats-meta content-stats-newsletter-sent-meta">
                        <div>
                          <dt>{copy.coverage}</dt>
                          <dd data-stats-newsletter-sent-coverage></dd>
                        </div>
                        <div>
                          <dt>{copy.lastCollected}</dt>
                          <dd data-stats-newsletter-sent-collected-date></dd>
                        </div>
                      </dl>
                    </details>
                  </div>
                </div>

                <div
                  class="content-stats-newsletter-email"
                  data-stats-newsletter-email-opens
                  data-stats-newsletter-email-opens-unavailable={copy.emailActivity.opens.unavailable}
                  aria-labelledby="content-stats-newsletter-email-opens-title"
                >
                  <h4 class="content-stats-newsletter-email-heading" id="content-stats-newsletter-email-opens-title">
                    {copy.emailActivity.opens.label}
                  </h4>
                  <p class="content-stats-newsletter-email-status" data-stats-newsletter-email-opens-status role="status" aria-live="polite" hidden>
                    {copy.emailActivity.opens.loading}
                  </p>
                  <div class="content-stats-newsletter-email-results" data-stats-newsletter-email-opens-results hidden>
                    <p class="content-stats-newsletter-email-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-email-opens-value></span>
                      <span data-stats-newsletter-email-opens-unit>{copy.emailActivity.opens.unit}</span>
                    </p>
                    <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                      <dl class="content-stats-meta content-stats-newsletter-email-meta">
                        <div>
                          <dt>{copy.coverage}</dt>
                          <dd data-stats-newsletter-email-opens-coverage></dd>
                        </div>
                        <div>
                          <dt>{copy.emailActivity.interval}</dt>
                          <dd data-stats-newsletter-email-opens-interval></dd>
                        </div>
                        <div>
                          <dt>{copy.emailActivity.collected}</dt>
                          <dd data-stats-newsletter-email-opens-collected-date></dd>
                        </div>
                      </dl>
                    </details>
                  </div>
                </div>

                <div
                  class="content-stats-newsletter-email"
                  data-stats-newsletter-email-verified-clicks
                  data-stats-newsletter-email-verified-clicks-unavailable={copy.emailActivity.verifiedClicks.unavailable}
                  aria-labelledby="content-stats-newsletter-email-verified-clicks-title"
                >
                  <h4 class="content-stats-newsletter-email-heading" id="content-stats-newsletter-email-verified-clicks-title">
                    {copy.emailActivity.verifiedClicks.label}
                  </h4>
                  <p class="content-stats-newsletter-email-status" data-stats-newsletter-email-verified-clicks-status role="status" aria-live="polite" hidden>
                    {copy.emailActivity.verifiedClicks.loading}
                  </p>
                  <div class="content-stats-newsletter-email-results" data-stats-newsletter-email-verified-clicks-results hidden>
                    <p class="content-stats-newsletter-email-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-email-verified-clicks-value></span>
                      <span data-stats-newsletter-email-verified-clicks-unit>{copy.emailActivity.verifiedClicks.unit}</span>
                    </p>
                    <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                      <dl class="content-stats-meta content-stats-newsletter-email-meta">
                        <div>
                          <dt>{copy.coverage}</dt>
                          <dd data-stats-newsletter-email-verified-clicks-coverage></dd>
                        </div>
                        <div>
                          <dt>{copy.emailActivity.interval}</dt>
                          <dd data-stats-newsletter-email-verified-clicks-interval></dd>
                        </div>
                        <div>
                          <dt>{copy.emailActivity.collected}</dt>
                          <dd data-stats-newsletter-email-verified-clicks-collected-date></dd>
                        </div>
                      </dl>
                    </details>
                  </div>
                </div>
              </>
            )}

            {kind === 'articles' && (
              <div
                class="content-stats-views content-stats-builder-views"
                data-stats-builder-views
                data-stats-builder-views-unavailable={copy.builderViews.unavailable}
                data-stats-builder-views-automatic-provenance={copy.builderViews.automaticProvenance}
                data-stats-builder-views-manual-provenance={copy.builderViews.manualProvenance}
                aria-labelledby="content-stats-builder-views-title"
                aria-busy="false"
              >
                <h4 class="content-stats-search-heading" id="content-stats-builder-views-title">
                  {copy.builderViews.title}
                </h4>
                <p class="content-stats-views-status" data-stats-builder-views-status role="status" aria-live="polite" hidden>
                  {copy.builderViews.loading}
                </p>
                <div class="content-stats-views-results" data-stats-builder-views-result hidden>
                  <p class="content-stats-views-count" role="status" aria-live="polite" aria-atomic="true">
                    <span data-stats-builder-views-value></span>
                    <span>{copy.builderViews.unit}</span>
                  </p>
                  <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                    <dl class="content-stats-meta content-stats-views-meta">
                      <div>
                        <dt>{copy.builderViews.coverage}</dt>
                        <dd data-stats-builder-views-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.builderViews.since}</dt>
                        <dd data-stats-builder-views-since></dd>
                      </div>
                      <div>
                        <dt>{copy.builderViews.observed}</dt>
                        <dd data-stats-builder-views-collected-date></dd>
                      </div>
                      <div>
                        <dt>{copy.builderViews.provenance}</dt>
                        <dd data-stats-builder-views-provenance></dd>
                      </div>
                    </dl>
                  </details>
                </div>
              </div>
            )}

            {kind === 'articles' && (
              <div class="content-stats-views" data-stats-views data-stats-views-unavailable={copy.viewsUnavailable} aria-labelledby="content-stats-views-title">
                <h4 class="content-stats-views-heading" id="content-stats-views-title">{copy.viewsTitle}</h4>
                <p class="content-stats-views-status" data-stats-views-status role="status" aria-live="polite" hidden>{copy.viewsLoading}</p>

                <div class="content-stats-views-results" data-stats-views-results hidden>
                  <p class="content-stats-views-count" role="status" aria-live="polite" aria-atomic="true">
                    <span data-stats-views-value></span>
                    <span data-stats-views-unit>{copy.viewsUnit}</span>
                  </p>

                  <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                    <dl class="content-stats-meta content-stats-views-meta">
                      <div>
                        <dt>{copy.viewsCoverage}</dt>
                        <dd data-stats-views-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.viewsInterval}</dt>
                        <dd data-stats-views-interval></dd>
                      </div>
                      <div>
                        <dt>{copy.viewsCollected}</dt>
                        <dd data-stats-views-collected-date></dd>
                      </div>
                    </dl>
                  </details>

                  <p class="content-stats-views-qualifications" data-stats-views-qualifications hidden></p>
                </div>
              </div>
            )}

            {kind === 'articles' && (
              <div class="content-stats-search" data-stats-search data-stats-search-unavailable={copy.searchUnavailable} aria-labelledby="content-stats-search-title">
                <h4 class="content-stats-search-heading" id="content-stats-search-title">{copy.searchTitle}</h4>
                <p class="content-stats-search-status" data-stats-search-status role="status" aria-live="polite" hidden>{copy.searchLoading}</p>

                <div class="content-stats-search-results" data-stats-search-results hidden>
                  <p class="content-stats-search-count" role="status" aria-live="polite" aria-atomic="true">
                    <span data-stats-search-value></span>
                    <span data-stats-search-unit>{copy.searchUnit}</span>
                  </p>

                  <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
                    <dl class="content-stats-meta content-stats-search-meta">
                      <div>
                        <dt>{copy.searchCoverage}</dt>
                        <dd data-stats-search-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.searchInterval}</dt>
                        <dd data-stats-search-interval></dd>
                      </div>
                      <div>
                        <dt>{copy.searchCollected}</dt>
                        <dd data-stats-search-collected-date></dd>
                      </div>
                    </dl>
                  </details>
                </div>
              </div>
            )}
          </article>
        );
      })}

      <article
        class="content-stats-card content-stats-directory-views"
        data-stats-kind="directory-views"
        data-stats-directory-views
        data-stats-directory-views-unavailable={copy.directoryViews.unavailable}
        data-stats-directory-outbound-clicks-unavailable={copy.directoryOutboundClicks.unavailable}
        aria-labelledby="content-stats-directory-views-title"
        aria-busy="false"
      >
        <div class="content-stats-card-heading">
          <div>
            <h3 id="content-stats-directory-views-title">{copy.directoryViews.title}</h3>
          </div>
        </div>

        <p class="content-stats-directory-views-status" data-stats-directory-views-status role="status" aria-live="polite" hidden>
          {copy.directoryViews.loading}
        </p>

        <div class="content-stats-directory-views-results" data-stats-directory-views-results hidden>
          <p class="content-stats-directory-views-count" role="status" aria-live="polite" aria-atomic="true">
            <span data-stats-directory-views-value></span>
            <span data-stats-directory-views-unit>{copy.directoryViews.unit}</span>
          </p>

          <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
            <dl class="content-stats-meta content-stats-directory-views-meta">
              <div>
                <dt>{copy.coverage}</dt>
                <dd data-stats-directory-views-coverage></dd>
              </div>
              <div>
                <dt>{copy.viewsInterval}</dt>
                <dd data-stats-directory-views-interval></dd>
              </div>
              <div>
                <dt>{copy.viewsCollected}</dt>
                <dd data-stats-directory-views-collected-date></dd>
              </div>
            </dl>
          </details>

          <p class="content-stats-directory-views-qualifications" data-stats-directory-views-qualifications hidden></p>
        </div>

        <div
          class="content-stats-directory-outbound-clicks"
          data-stats-directory-outbound-clicks
          aria-labelledby="content-stats-directory-outbound-clicks-title"
        >
          <h4 class="content-stats-directory-outbound-clicks-heading" id="content-stats-directory-outbound-clicks-title">
            {copy.directoryOutboundClicks.title}
          </h4>
          <p class="content-stats-directory-outbound-clicks-status" data-stats-directory-outbound-clicks-status role="status" aria-live="polite" hidden>
            {copy.directoryOutboundClicks.loading}
          </p>

          <div class="content-stats-directory-outbound-clicks-results" data-stats-directory-outbound-clicks-results hidden>
            <p class="content-stats-directory-outbound-clicks-count" role="status" aria-live="polite" aria-atomic="true">
              <span data-stats-directory-outbound-clicks-value></span>
              <span data-stats-directory-outbound-clicks-unit>{copy.directoryOutboundClicks.unit}</span>
            </p>

            <details class="content-stats-details"><summary>{copy.metadataSummary}</summary>
              <dl class="content-stats-meta content-stats-directory-outbound-clicks-meta">
                <div>
                  <dt>{copy.coverage}</dt>
                  <dd data-stats-directory-outbound-clicks-coverage></dd>
                </div>
                <div>
                  <dt>{copy.directoryOutboundClicks.interval}</dt>
                  <dd data-stats-directory-outbound-clicks-interval></dd>
                </div>
                <div>
                  <dt>{copy.directoryOutboundClicks.collected}</dt>
                  <dd data-stats-directory-outbound-clicks-collected-date></dd>
                </div>
              </dl>
            </details>

            <p class="content-stats-directory-outbound-clicks-qualifications" data-stats-directory-outbound-clicks-qualifications hidden></p>
          </div>
        </div>
      </article>
    </div>

    <details class="content-stats-sources">
      <summary>{copy.sourcesSummary}</summary>
      <ul>
        {copy.sourcesExplanation.map((item) => <li>{item}</li>)}
      </ul>
      <p><a href={locale === 'en' ? '/content-statistics/privacy/' : '/es/content-statistics/privacy/'}>{copy.privacyLink}</a></p>
    </details>
      </div>
    </details>

    <noscript><p class="content-stats-noscript">{copy.noScript}</p></noscript>
  </div>
</section>

<script src="../scripts/content-stats.js"></script>
