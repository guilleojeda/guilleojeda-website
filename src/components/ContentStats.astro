---
import type { Locale } from '../content/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'en'
  ? {
      kicker: 'Content statistics',
      title: 'Content & reach',
      intro: 'Published articles, delivered talks and sessions, published books, current newsletter subscribers, emails sent, email opens and verified email clicks, and page views and external link clicks for the Dónde Aprendo AWS directory, with partial coverage of the wider body of work. Directory traffic and clicks remain separate from article readership and incoming Search. Email opens and verified clicks follow the selected period; reported emails sent stay cumulative. Article counts stay cumulative and subscribers stay current.',
      filterLabel: 'Content language',
      periodLabel: 'Activity period',
      all: 'All',
      english: 'English',
      spanish: 'Español',
      periods: {
        '7d': 'Last 7 days',
        '30d': 'Last 30 days',
        '90d': 'Last 90 days',
        '12m': 'Last 12 months',
        ytd: 'Year to date',
        total: 'Recorded total'
      },
      cumulative: 'Cumulative total',
      currentSubscribers: 'Current active subscribers',
      newsletterSent: {
        label: 'Emails sent — reported total',
        unit: 'emails sent',
        loading: 'Loading reported emails sent…',
        unavailable: 'The reported emails-sent total is unavailable.'
      },
      coverage: 'Coverage',
      lastCollected: 'Last updated',
      viewsLoading: 'Loading article views…',
      viewsUnavailable: 'Views are unavailable for this period.',
      viewsUnit: 'views',
      viewsCoverage: 'Coverage',
      viewsInterval: 'Reporting interval',
      viewsCollected: 'Collected',
      searchTitle: 'Google Search clicks',
      searchLoading: 'Loading Google Search Console clicks…',
      searchUnavailable: 'Search clicks are unavailable for this period.',
      searchUnit: 'clicks',
      searchCoverage: 'Coverage',
      searchInterval: 'Reporting interval',
      searchCollected: 'Collected',
      noScript: 'Enable JavaScript to view these content statistics.',
      cards: {
        articles: {
          title: 'Articles',
          unit: 'published articles',
          loading: 'Loading article statistics…',
          unavailable: 'Article statistics are temporarily unavailable.'
        },
        talks: {
          title: 'Talks & sessions',
          unit: 'sessions',
          loading: 'Loading speaking statistics…',
          unavailable: 'Speaking statistics are temporarily unavailable.'
        },
        books: {
          title: 'Books',
          unit: 'published books',
          loading: 'Loading book statistics…',
          unavailable: 'Book statistics are temporarily unavailable.'
        },
        newsletter: {
          title: 'Newsletter',
          unit: 'active subscribers',
          loading: 'Loading newsletter statistics…',
          unavailable: 'Newsletter statistics are temporarily unavailable.'
        }
      },
      directoryViews: {
        title: 'Dónde Aprendo AWS',
        loading: 'Loading Dónde Aprendo AWS page views…',
        unavailable: 'Dónde Aprendo AWS page views are unavailable for this period.',
        unit: 'page views'
      },
      directoryOutboundClicks: {
        title: 'External link clicks',
        loading: 'Loading Dónde Aprendo AWS external link clicks…',
        unavailable: 'Dónde Aprendo AWS external link clicks are unavailable for this period.',
        unit: 'clicks',
        interval: 'Reporting interval',
        collected: 'Collected'
      },
      sourcesSummary: 'Sources and counting',
      privacyLink: 'Statistics privacy and use',
      emailActivity: {
        opens: {
          label: 'Email opens',
          unit: 'Email opens',
          loading: 'Loading email opens…',
          unavailable: 'Email opens are unavailable for this period.'
        },
        verifiedClicks: {
          label: 'Verified email clicks',
          unit: 'Verified email clicks',
          loading: 'Loading verified email clicks…',
          unavailable: 'Verified email clicks are unavailable for this period.'
        },
        interval: 'Reporting interval',
        collected: 'Collected'
      },
      sourcesExplanation: 'These statistics can include Caylent and AWS Builder Center; the labels above show the sources included in each count. Article counts can include Simple AWS posts published on the web, by email or both, and can include Cloudy Things posts, including eligible originals and republications. Translations count separately using the article’s actual content language. Matching titles in the same language count once across sources; different titles count separately. Article views cover Simple AWS page views on its newsletter publication, a partial scope that differs from article-count coverage; repeated views can come from the same person. Page views for the Dónde Aprendo AWS directory cover the full directory and can repeat; they are reported separately from article views and do not represent unique readers. GA4-recorded outbound link clicks for Dónde Aprendo AWS include links to the publication and social channels, including footer links; one person can click more than once. They are reported separately from directory page views and incoming Search clicks. Recorded totals cover available activity from the displayed start date; earlier activity and gaps in tracking may be missing. Views are reported with a delay and may be revised later. Google Search Console clicks for Simple AWS cover canonical or Google-preferred article URLs and remain separate from Views. They are a partial reported measure: Google’s filtering and reporting limits may omit clicks, and clicks are not unique people or readers. Search clicks use their own interval and date, are delayed, and may be revised; they are not added to Analytics views. Email opens are reported tracking-pixel events; privacy protections and automated loads can count as opens, and some reads may not register. Verified email clicks are Beehiiv-filtered click events; they can repeat and are not a count of unique people. Email figures cover currently available history returned by Beehiiv; tracking gaps may omit activity and reported values can change later. Beehiiv’s reported cumulative total of emails sent can include multiple emails to one person; its available history may be incomplete or revised, and the total does not follow the selected activity period. All includes both language counts; each card shows its own last successful update. Talks count delivered talks, workshops, training, panels, and technical sessions; repeated deliveries at different events count separately. Host-only appearances, commentary, podcasts, conversations, and upcoming sessions are excluded. Books count published titles, including historical books whose current source is unavailable; books in progress are excluded. Talk and book languages follow their original titles. Simple AWS is an English newsletter; its current subscriber figure counts active subscriptions.'
    }
  : {
      kicker: 'Estadísticas de contenido',
      title: 'Contenido y alcance',
      intro: 'Artículos publicados, charlas y sesiones realizadas, libros publicados, suscriptores actuales del boletín, emails enviados, aperturas y clics verificados, y vistas de página y clics en enlaces externos del directorio Dónde Aprendo AWS, con cobertura parcial del conjunto más amplio de trabajo. El tráfico y los clics del directorio se mantienen separados de la lectura de artículos y de las búsquedas entrantes. Las aperturas y los clics verificados en emails siguen el período seleccionado; el total informado de emails enviados es acumulado. El conteo de artículos es acumulado y los suscriptores son actuales.',
      filterLabel: 'Idioma del contenido',
      periodLabel: 'Período de actividad',
      all: 'Todos',
      english: 'English',
      spanish: 'Español',
      periods: {
        '7d': 'Últimos 7 días',
        '30d': 'Últimos 30 días',
        '90d': 'Últimos 90 días',
        '12m': 'Últimos 12 meses',
        ytd: 'Año hasta la fecha',
        total: 'Total registrado'
      },
      cumulative: 'Total acumulado',
      currentSubscribers: 'Suscriptores actuales',
      newsletterSent: {
        label: 'Emails enviados — total informado',
        unit: 'emails enviados',
        loading: 'Cargando el total informado de emails enviados…',
        unavailable: 'No disponible: el total informado de emails enviados.'
      },
      coverage: 'Cobertura',
      lastCollected: 'Última actualización',
      viewsLoading: 'Cargando vistas de artículos…',
      viewsUnavailable: 'No se pueden mostrar las vistas para este período.',
      viewsUnit: 'vistas',
      viewsCoverage: 'Cobertura',
      viewsInterval: 'Intervalo informado',
      viewsCollected: 'Recopilado',
      searchTitle: 'Clics de búsqueda de Google',
      searchLoading: 'Cargando clics de Google Search Console…',
      searchUnavailable: 'No se pueden mostrar los clics de búsqueda para este período.',
      searchUnit: 'clics',
      searchCoverage: 'Cobertura',
      searchInterval: 'Intervalo informado',
      searchCollected: 'Recopilado',
      noScript: 'Activa JavaScript para ver estas estadísticas de contenido.',
      cards: {
        articles: {
          title: 'Artículos',
          unit: 'artículos publicados',
          loading: 'Cargando estadísticas de artículos…',
          unavailable: 'No se pueden cargar las estadísticas de artículos por el momento.'
        },
        talks: {
          title: 'Charlas y sesiones',
          unit: 'sesiones',
          loading: 'Cargando estadísticas de sesiones…',
          unavailable: 'Las estadísticas de sesiones no están disponibles por el momento.'
        },
        books: {
          title: 'Libros',
          unit: 'libros publicados',
          loading: 'Cargando estadísticas de libros…',
          unavailable: 'Las estadísticas de libros no están disponibles por el momento.'
        },
        newsletter: {
          title: 'Boletín',
          unit: 'suscriptores activos',
          loading: 'Cargando estadísticas del boletín…',
          unavailable: 'Las estadísticas del boletín no están disponibles por el momento.'
        }
      },
      directoryViews: {
        title: 'Dónde Aprendo AWS',
        loading: 'Cargando vistas de página de Dónde Aprendo AWS…',
        unavailable: 'No se pueden mostrar las vistas de página de Dónde Aprendo AWS para este período.',
        unit: 'vistas de página'
      },
      directoryOutboundClicks: {
        title: 'Clics en enlaces externos',
        loading: 'Cargando clics en enlaces externos de Dónde Aprendo AWS…',
        unavailable: 'Clics en enlaces externos de Dónde Aprendo AWS: no disponibles para este período.',
        unit: 'clics',
        interval: 'Intervalo informado',
        collected: 'Recopilado'
      },
      sourcesSummary: 'Fuentes y conteo',
      privacyLink: 'Privacidad y uso de las estadísticas',
      emailActivity: {
        opens: {
          label: 'Aperturas de emails',
          unit: 'Aperturas de emails',
          loading: 'Cargando aperturas de emails…',
          unavailable: 'No se pueden mostrar las aperturas de emails para este período.'
        },
        verifiedClicks: {
          label: 'Clics verificados en emails',
          unit: 'Clics verificados en emails',
          loading: 'Cargando clics verificados en emails…',
          unavailable: 'No se pueden mostrar los clics verificados en emails para este período.'
        },
        interval: 'Intervalo informado',
        collected: 'Recopilado'
      },
      sourcesExplanation: 'Estas estadísticas pueden incluir Caylent y AWS Builder Center; los nombres de arriba indican las fuentes de cada conteo. El conteo de artículos puede incluir las publicaciones de Simple AWS difundidas en la web, por correo electrónico o en ambos, y puede incluir publicaciones de Cloudy Things, incluidos originales y republicaciones elegibles. Las traducciones se cuentan por separado según el idioma real del contenido. Los títulos iguales en el mismo idioma se cuentan una sola vez, incluso entre fuentes; los títulos distintos se cuentan por separado. Las vistas de artículos cubren las vistas de páginas de la publicación Simple AWS: es una cobertura parcial y distinta de la del conteo de artículos; una misma persona puede generar vistas repetidas. Las vistas de página del directorio Dónde Aprendo AWS cubren el directorio completo y también pueden repetirse; se informan por separado de las vistas de artículos y no representan lectores únicos. En Dónde Aprendo AWS, los clics en enlaces externos registrados por GA4 incluyen enlaces a la publicación y a redes sociales, incluidos los enlaces del pie de página; una persona puede hacer clic más de una vez. Se informan por separado de las vistas de página del directorio y de los clics de búsqueda entrantes. Los totales registrados muestran la actividad disponible desde la fecha indicada; puede faltar actividad anterior o de períodos sin seguimiento. Las vistas tienen demora y pueden revisarse más adelante. Los clics de Google Search Console de Simple AWS cubren URLs de artículos canónicas o preferidas por Google y se mantienen separados de las vistas. Son una medida parcial: los filtros y límites del informe pueden omitir clics; no representan personas únicas. Los clics de búsqueda tienen su propio intervalo y fecha, pueden tener demora y revisarse, y no se suman a las vistas de Analytics. Las aperturas de emails son eventos informados mediante píxeles de seguimiento; las protecciones de privacidad y las cargas automáticas pueden contarse como aperturas, y algunas lecturas pueden no registrarse. Los clics verificados en emails cuentan eventos filtrados por Beehiiv; los clics pueden repetirse y no representan personas únicas. Las cifras de emails cubren el historial disponible que devuelve Beehiiv; los períodos sin seguimiento pueden omitir actividad y los valores informados pueden cambiar más adelante. El total acumulado de emails enviados que informa Beehiiv puede incluir varios emails para una misma persona; su historial disponible puede ser incompleto o revisarse, y este total no sigue el período de actividad seleccionado. El total incluye ambos idiomas; cada tarjeta muestra su propia última actualización correcta. Las charlas cuentan charlas, workshops, capacitaciones, paneles y sesiones técnicas realizadas; las entregas repetidas en eventos distintos cuentan por separado. Se excluyen apariciones únicamente como anfitrión, comentarios, podcasts, conversaciones y sesiones futuras. Los libros cuentan títulos publicados, incluidos los libros históricos cuya fuente actual no está disponible; se excluyen los libros en preparación. El idioma de las charlas y los libros se determina por sus títulos originales. Simple AWS es un boletín en inglés; la cifra actual cuenta sus suscripciones activas.'
    };

const cardKinds = ['articles', 'talks', 'books', 'newsletter'] as const;
---

<section
  class="section content-stats"
  id="content-stats"
  aria-labelledby="content-stats-title"
  data-stats-source="/content-stats/v1/current.json"
  data-stats-locale={locale}
>
  <div class="section-shell">
    <div class="section-heading">
      <div class="section-kicker">{copy.kicker}</div>
      <div>
        <h2 id="content-stats-title">{copy.title}</h2>
        <p>{copy.intro}</p>
      </div>
    </div>

    <div class="content-stats-controls">
      <div class="content-stats-control">
        <label for="content-stats-language">{copy.filterLabel}</label>
        <select id="content-stats-language" data-stats-language disabled>
          <option value="all" selected>{copy.all}</option>
          <option value="en">{copy.english}</option>
          <option value="es">{copy.spanish}</option>
        </select>
      </div>
      <div class="content-stats-control">
        <label for="content-stats-period">{copy.periodLabel}</label>
        <select id="content-stats-period" data-stats-period disabled>
          {(['7d', '30d', '90d', '12m', 'ytd', 'total'] as const).map((period) => (
            <option value={period} selected={period === '12m'} disabled={period === 'total'}>{copy.periods[period]}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="content-stats-cards">
      {cardKinds.map((kind) => {
        const card = copy.cards[kind];
        return (
          <article class="content-stats-card" data-stats-kind={kind} data-stats-unavailable={card.unavailable} aria-labelledby={`content-stats-${kind}-title`} aria-busy="false">
            <div class="content-stats-card-heading">
              <div>
                {kind !== 'newsletter' && <div class="work-kicker">{copy.cumulative}</div>}
                <h3 id={`content-stats-${kind}-title`}>{card.title}</h3>
              </div>
            </div>

            <p class="content-stats-status" data-stats-status role="status" aria-live="polite" hidden>{card.loading}</p>

            <div class="content-stats-results" data-stats-results hidden>
              <p class="content-stats-count" data-stats-count-region role="status" aria-live="polite" aria-atomic="true">
                <span data-stats-count></span>
                <span data-stats-count-label>{kind === 'newsletter' ? copy.currentSubscribers : card.unit}</span>
              </p>

              <dl class="content-stats-meta">
                <div>
                  <dt>{copy.coverage}</dt>
                  <dd data-stats-coverage></dd>
                </div>
                <div>
                  <dt>{copy.lastCollected}</dt>
                  <dd data-stats-collected-date></dd>
                </div>
              </dl>

            </div>

            {kind === 'newsletter' && (
              <>
                <div
                  class="content-stats-newsletter-sent"
                  data-stats-newsletter-sent
                  data-stats-newsletter-sent-unavailable={copy.newsletterSent.unavailable}
                  aria-labelledby="content-stats-newsletter-sent-title"
                >
                  <h4 class="content-stats-newsletter-sent-heading" id="content-stats-newsletter-sent-title">
                    {copy.newsletterSent.label}
                  </h4>
                  <p class="content-stats-newsletter-sent-status" data-stats-newsletter-sent-status role="status" aria-live="polite" hidden>
                    {copy.newsletterSent.loading}
                  </p>
                  <div class="content-stats-newsletter-sent-results" data-stats-newsletter-sent-results hidden>
                    <p class="content-stats-newsletter-sent-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-sent-value></span>
                      <span>{copy.newsletterSent.unit}</span>
                    </p>
                    <dl class="content-stats-meta content-stats-newsletter-sent-meta">
                      <div>
                        <dt>{copy.coverage}</dt>
                        <dd data-stats-newsletter-sent-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.lastCollected}</dt>
                        <dd data-stats-newsletter-sent-collected-date></dd>
                      </div>
                    </dl>
                  </div>
                </div>

                <div
                  class="content-stats-newsletter-email"
                  data-stats-newsletter-email-opens
                  data-stats-newsletter-email-opens-unavailable={copy.emailActivity.opens.unavailable}
                  aria-labelledby="content-stats-newsletter-email-opens-title"
                >
                  <h4 class="content-stats-newsletter-email-heading" id="content-stats-newsletter-email-opens-title">
                    {copy.emailActivity.opens.label}
                  </h4>
                  <p class="content-stats-newsletter-email-status" data-stats-newsletter-email-opens-status role="status" aria-live="polite" hidden>
                    {copy.emailActivity.opens.loading}
                  </p>
                  <div class="content-stats-newsletter-email-results" data-stats-newsletter-email-opens-results hidden>
                    <p class="content-stats-newsletter-email-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-email-opens-value></span>
                      <span data-stats-newsletter-email-opens-unit>{copy.emailActivity.opens.unit}</span>
                    </p>
                    <dl class="content-stats-meta content-stats-newsletter-email-meta">
                      <div>
                        <dt>{copy.coverage}</dt>
                        <dd data-stats-newsletter-email-opens-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.emailActivity.interval}</dt>
                        <dd data-stats-newsletter-email-opens-interval></dd>
                      </div>
                      <div>
                        <dt>{copy.emailActivity.collected}</dt>
                        <dd data-stats-newsletter-email-opens-collected-date></dd>
                      </div>
                    </dl>
                  </div>
                </div>

                <div
                  class="content-stats-newsletter-email"
                  data-stats-newsletter-email-verified-clicks
                  data-stats-newsletter-email-verified-clicks-unavailable={copy.emailActivity.verifiedClicks.unavailable}
                  aria-labelledby="content-stats-newsletter-email-verified-clicks-title"
                >
                  <h4 class="content-stats-newsletter-email-heading" id="content-stats-newsletter-email-verified-clicks-title">
                    {copy.emailActivity.verifiedClicks.label}
                  </h4>
                  <p class="content-stats-newsletter-email-status" data-stats-newsletter-email-verified-clicks-status role="status" aria-live="polite" hidden>
                    {copy.emailActivity.verifiedClicks.loading}
                  </p>
                  <div class="content-stats-newsletter-email-results" data-stats-newsletter-email-verified-clicks-results hidden>
                    <p class="content-stats-newsletter-email-count" role="status" aria-live="polite" aria-atomic="true">
                      <span data-stats-newsletter-email-verified-clicks-value></span>
                      <span data-stats-newsletter-email-verified-clicks-unit>{copy.emailActivity.verifiedClicks.unit}</span>
                    </p>
                    <dl class="content-stats-meta content-stats-newsletter-email-meta">
                      <div>
                        <dt>{copy.coverage}</dt>
                        <dd data-stats-newsletter-email-verified-clicks-coverage></dd>
                      </div>
                      <div>
                        <dt>{copy.emailActivity.interval}</dt>
                        <dd data-stats-newsletter-email-verified-clicks-interval></dd>
                      </div>
                      <div>
                        <dt>{copy.emailActivity.collected}</dt>
                        <dd data-stats-newsletter-email-verified-clicks-collected-date></dd>
                      </div>
                    </dl>
                  </div>
                </div>
              </>
            )}

            {kind === 'articles' && (
              <div class="content-stats-views" data-stats-views data-stats-views-unavailable={copy.viewsUnavailable}>
                <p class="content-stats-views-status" data-stats-views-status role="status" aria-live="polite" hidden>{copy.viewsLoading}</p>

                <div class="content-stats-views-results" data-stats-views-results hidden>
                  <p class="content-stats-views-count" role="status" aria-live="polite" aria-atomic="true">
                    <span data-stats-views-value></span>
                    <span data-stats-views-unit>{copy.viewsUnit}</span>
                  </p>

                  <dl class="content-stats-meta content-stats-views-meta">
                    <div>
                      <dt>{copy.viewsCoverage}</dt>
                      <dd data-stats-views-coverage></dd>
                    </div>
                    <div>
                      <dt>{copy.viewsInterval}</dt>
                      <dd data-stats-views-interval></dd>
                    </div>
                    <div>
                      <dt>{copy.viewsCollected}</dt>
                      <dd data-stats-views-collected-date></dd>
                    </div>
                  </dl>

                  <p class="content-stats-views-qualifications" data-stats-views-qualifications hidden></p>
                </div>
              </div>
            )}

            {kind === 'articles' && (
              <div class="content-stats-search" data-stats-search data-stats-search-unavailable={copy.searchUnavailable}>
                <p class="content-stats-search-heading">{copy.searchTitle}</p>
                <p class="content-stats-search-status" data-stats-search-status role="status" aria-live="polite" hidden>{copy.searchLoading}</p>

                <div class="content-stats-search-results" data-stats-search-results hidden>
                  <p class="content-stats-search-count" role="status" aria-live="polite" aria-atomic="true">
                    <span data-stats-search-value></span>
                    <span data-stats-search-unit>{copy.searchUnit}</span>
                  </p>

                  <dl class="content-stats-meta content-stats-search-meta">
                    <div>
                      <dt>{copy.searchCoverage}</dt>
                      <dd data-stats-search-coverage></dd>
                    </div>
                    <div>
                      <dt>{copy.searchInterval}</dt>
                      <dd data-stats-search-interval></dd>
                    </div>
                    <div>
                      <dt>{copy.searchCollected}</dt>
                      <dd data-stats-search-collected-date></dd>
                    </div>
                  </dl>
                </div>
              </div>
            )}
          </article>
        );
      })}

      <article
        class="content-stats-card content-stats-directory-views"
        data-stats-kind="directory-views"
        data-stats-directory-views
        data-stats-directory-views-unavailable={copy.directoryViews.unavailable}
        data-stats-directory-outbound-clicks-unavailable={copy.directoryOutboundClicks.unavailable}
        aria-labelledby="content-stats-directory-views-title"
        aria-busy="false"
      >
        <div class="content-stats-card-heading">
          <div>
            <div class="work-kicker">{copy.periodLabel}</div>
            <h3 id="content-stats-directory-views-title">{copy.directoryViews.title}</h3>
          </div>
        </div>

        <p class="content-stats-directory-views-status" data-stats-directory-views-status role="status" aria-live="polite" hidden>
          {copy.directoryViews.loading}
        </p>

        <div class="content-stats-directory-views-results" data-stats-directory-views-results hidden>
          <p class="content-stats-directory-views-count" role="status" aria-live="polite" aria-atomic="true">
            <span data-stats-directory-views-value></span>
            <span data-stats-directory-views-unit>{copy.directoryViews.unit}</span>
          </p>

          <dl class="content-stats-meta content-stats-directory-views-meta">
            <div>
              <dt>{copy.coverage}</dt>
              <dd data-stats-directory-views-coverage></dd>
            </div>
            <div>
              <dt>{copy.viewsInterval}</dt>
              <dd data-stats-directory-views-interval></dd>
            </div>
            <div>
              <dt>{copy.viewsCollected}</dt>
              <dd data-stats-directory-views-collected-date></dd>
            </div>
          </dl>

          <p class="content-stats-directory-views-qualifications" data-stats-directory-views-qualifications hidden></p>
        </div>

        <div
          class="content-stats-directory-outbound-clicks"
          data-stats-directory-outbound-clicks
          aria-labelledby="content-stats-directory-outbound-clicks-title"
        >
          <h4 class="content-stats-directory-outbound-clicks-heading" id="content-stats-directory-outbound-clicks-title">
            {copy.directoryOutboundClicks.title}
          </h4>
          <p class="content-stats-directory-outbound-clicks-status" data-stats-directory-outbound-clicks-status role="status" aria-live="polite" hidden>
            {copy.directoryOutboundClicks.loading}
          </p>

          <div class="content-stats-directory-outbound-clicks-results" data-stats-directory-outbound-clicks-results hidden>
            <p class="content-stats-directory-outbound-clicks-count" role="status" aria-live="polite" aria-atomic="true">
              <span data-stats-directory-outbound-clicks-value></span>
              <span data-stats-directory-outbound-clicks-unit>{copy.directoryOutboundClicks.unit}</span>
            </p>

            <dl class="content-stats-meta content-stats-directory-outbound-clicks-meta">
              <div>
                <dt>{copy.coverage}</dt>
                <dd data-stats-directory-outbound-clicks-coverage></dd>
              </div>
              <div>
                <dt>{copy.directoryOutboundClicks.interval}</dt>
                <dd data-stats-directory-outbound-clicks-interval></dd>
              </div>
              <div>
                <dt>{copy.directoryOutboundClicks.collected}</dt>
                <dd data-stats-directory-outbound-clicks-collected-date></dd>
              </div>
            </dl>

            <p class="content-stats-directory-outbound-clicks-qualifications" data-stats-directory-outbound-clicks-qualifications hidden></p>
          </div>
        </div>
      </article>
    </div>

    <details class="content-stats-sources">
      <summary>{copy.sourcesSummary}</summary>
      <p>
        {copy.sourcesExplanation}{' '}
        <a href={locale === 'en' ? '/content-statistics/privacy/' : '/es/content-statistics/privacy/'}>{copy.privacyLink}</a>
      </p>
    </details>

    <noscript><p class="content-stats-noscript">{copy.noScript}</p></noscript>
  </div>
</section>

