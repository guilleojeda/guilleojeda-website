---
import type { Locale } from '../content/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'en'
  ? {
      kicker: 'Content statistics',
      title: 'Content & reach',
      intro: 'Published articles across the sources listed below, with partial coverage of the wider archive.',
      filterLabel: 'Content language',
      all: 'All',
      english: 'English',
      spanish: 'Español',
      cardTitle: 'Articles',
      cumulative: 'Cumulative total',
      publishedArticles: 'published articles',
      coverage: 'Coverage',
      lastCollected: 'Last updated',
      reachUnavailable: 'Reach statistics are not available yet.',
      loading: 'Loading article statistics…',
      unavailable: 'Article statistics are temporarily unavailable.',
      sourcesSummary: 'Sources and counting',
      sourcesExplanation: 'These statistics can include Caylent and AWS Builder Center; the labels above show the sources included in this count. Translations count separately using the article’s actual content language. Matching titles in the same language count once across sources; different titles count separately. This is partial coverage; other publication archives are not included. All includes both language counts; the date is the last successful update.',
      noScript: 'Enable JavaScript to view these article statistics.'
    }
  : {
      kicker: 'Estadísticas de contenido',
      title: 'Contenido y alcance',
      intro: 'Artículos publicados en las fuentes indicadas abajo, con cobertura parcial del archivo más amplio.',
      filterLabel: 'Idioma del contenido',
      all: 'Todos',
      english: 'English',
      spanish: 'Español',
      cardTitle: 'Artículos',
      cumulative: 'Total acumulado',
      publishedArticles: 'artículos publicados',
      coverage: 'Cobertura',
      lastCollected: 'Última actualización',
      reachUnavailable: 'Las estadísticas de alcance todavía no están disponibles.',
      loading: 'Cargando estadísticas de artículos…',
      unavailable: 'No se pueden cargar las estadísticas de artículos por el momento.',
      sourcesSummary: 'Fuentes y conteo',
      sourcesExplanation: 'Estas estadísticas pueden incluir Caylent y AWS Builder Center; los nombres de arriba indican las fuentes de este conteo. Las traducciones se cuentan por separado según el idioma real del contenido. Los títulos iguales en el mismo idioma se cuentan una sola vez, incluso entre fuentes; los títulos distintos se cuentan por separado. La cobertura parcial deja fuera otros archivos de publicaciones. El total incluye ambos idiomas; la fecha indica la última actualización correcta.',
      noScript: 'Activa JavaScript para ver estas estadísticas de artículos.'
    };
---

<section
  class="section content-stats"
  id="content-stats"
  aria-labelledby="content-stats-title"
  data-stats-source="/content-stats/v1/current.json"
  data-stats-locale={locale}
  data-stats-unavailable={copy.unavailable}
>
  <div class="section-shell">
    <div class="section-heading">
      <div class="section-kicker">{copy.kicker}</div>
      <div>
        <h2 id="content-stats-title">{copy.title}</h2>
        <p>{copy.intro}</p>
      </div>
    </div>

    <div class="content-stats-controls">
      <label for="content-stats-language">{copy.filterLabel}</label>
      <select id="content-stats-language" data-stats-language disabled>
        <option value="all" selected>{copy.all}</option>
        <option value="en">{copy.english}</option>
        <option value="es">{copy.spanish}</option>
      </select>
    </div>

    <article class="content-stats-card" data-stats-kind="articles" aria-labelledby="content-stats-articles-title" aria-busy="false">
      <div class="content-stats-card-heading">
        <div>
          <div class="work-kicker">{copy.cumulative}</div>
          <h3 id="content-stats-articles-title">{copy.cardTitle}</h3>
        </div>
      </div>

      <p class="content-stats-status" data-stats-status role="status" aria-live="polite" hidden>{copy.loading}</p>

      <div class="content-stats-results" data-stats-results hidden>
        <p class="content-stats-count" data-stats-count-region role="status" aria-live="polite" aria-atomic="true">
          <span data-stats-count></span>
          <span data-stats-count-label>{copy.publishedArticles}</span>
        </p>

        <dl class="content-stats-meta">
          <div>
            <dt>{copy.coverage}</dt>
            <dd data-stats-coverage></dd>
          </div>
          <div>
            <dt>{copy.lastCollected}</dt>
            <dd data-stats-collected-date></dd>
          </div>
        </dl>

        <p class="content-stats-reach">{copy.reachUnavailable}</p>
      </div>
    </article>

    <details class="content-stats-sources">
      <summary>{copy.sourcesSummary}</summary>
      <p>{copy.sourcesExplanation}</p>
    </details>

    <noscript><p class="content-stats-noscript">{copy.noScript}</p></noscript>
  </div>
</section>

<script src="../scripts/content-stats.js"></script>
