---
import type { Locale } from '../content/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'en'
  ? {
      kicker: 'Content statistics',
      title: 'Content & reach',
      intro: 'Published articles, delivered talks and sessions, published books, and current newsletter subscribers, with partial coverage of the wider body of work.',
      filterLabel: 'Content language',
      all: 'All',
      english: 'English',
      spanish: 'Español',
      cumulative: 'Cumulative total',
      current: 'Current',
      coverage: 'Coverage',
      lastCollected: 'Last updated',
      reachUnavailable: 'Reach statistics are not available yet.',
      noScript: 'Enable JavaScript to view these content statistics.',
      cards: {
        articles: {
          title: 'Articles',
          unit: 'published articles',
          loading: 'Loading article statistics…',
          unavailable: 'Article statistics are temporarily unavailable.'
        },
        talks: {
          title: 'Talks & sessions',
          unit: 'sessions',
          loading: 'Loading speaking statistics…',
          unavailable: 'Speaking statistics are temporarily unavailable.'
        },
        books: {
          title: 'Books',
          unit: 'published books',
          loading: 'Loading book statistics…',
          unavailable: 'Book statistics are temporarily unavailable.'
        },
        newsletter: {
          title: 'Newsletter',
          unit: 'active subscribers',
          loading: 'Loading newsletter statistics…',
          unavailable: 'Newsletter statistics are temporarily unavailable.'
        }
      },
      sourcesSummary: 'Sources and counting',
      sourcesExplanation: 'These statistics can include Caylent and AWS Builder Center; the labels above show the sources included in this count. Translations count separately using the article’s actual content language. Matching titles in the same language count once across sources; different titles count separately. This is partial coverage; other publication archives are not included. All includes both language counts; each card shows its own last successful update. Talks count delivered talks, workshops, training, panels, and technical sessions; repeated deliveries at different events count separately. Host-only appearances, commentary, podcasts, conversations, and upcoming sessions are excluded. Books count published titles, including historical books whose current source is unavailable; books in progress are excluded. Talk and book languages follow their original titles. Simple AWS is an English newsletter; its current subscriber figure counts active subscriptions.'
    }
  : {
      kicker: 'Estadísticas de contenido',
      title: 'Contenido y alcance',
      intro: 'Artículos publicados, charlas y sesiones realizadas, libros publicados y suscriptores actuales del boletín, con cobertura parcial del conjunto más amplio de trabajo.',
      filterLabel: 'Idioma del contenido',
      all: 'Todos',
      english: 'English',
      spanish: 'Español',
      cumulative: 'Total acumulado',
      current: 'Suscriptores actuales',
      coverage: 'Cobertura',
      lastCollected: 'Última actualización',
      reachUnavailable: 'Las estadísticas de alcance todavía no están disponibles.',
      noScript: 'Activa JavaScript para ver estas estadísticas de contenido.',
      cards: {
        articles: {
          title: 'Artículos',
          unit: 'artículos publicados',
          loading: 'Cargando estadísticas de artículos…',
          unavailable: 'No se pueden cargar las estadísticas de artículos por el momento.'
        },
        talks: {
          title: 'Charlas y sesiones',
          unit: 'sesiones',
          loading: 'Cargando estadísticas de sesiones…',
          unavailable: 'Las estadísticas de sesiones no están disponibles por el momento.'
        },
        books: {
          title: 'Libros',
          unit: 'libros publicados',
          loading: 'Cargando estadísticas de libros…',
          unavailable: 'Las estadísticas de libros no están disponibles por el momento.'
        },
        newsletter: {
          title: 'Boletín',
          unit: 'suscriptores activos',
          loading: 'Cargando estadísticas del boletín…',
          unavailable: 'Las estadísticas del boletín no están disponibles por el momento.'
        }
      },
      sourcesSummary: 'Fuentes y conteo',
      sourcesExplanation: 'Estas estadísticas pueden incluir Caylent y AWS Builder Center; los nombres de arriba indican las fuentes de este conteo. Las traducciones se cuentan por separado según el idioma real del contenido. Los títulos iguales en el mismo idioma se cuentan una sola vez, incluso entre fuentes; los títulos distintos se cuentan por separado. La cobertura parcial deja fuera otros archivos de publicaciones. El total incluye ambos idiomas; cada tarjeta muestra su propia última actualización correcta. Las charlas cuentan charlas, workshops, capacitaciones, paneles y sesiones técnicas realizadas; las entregas repetidas en eventos distintos cuentan por separado. Se excluyen apariciones únicamente como anfitrión, comentarios, podcasts, conversaciones y sesiones futuras. Los libros cuentan títulos publicados, incluidos los libros históricos cuya fuente actual no está disponible; se excluyen los libros en preparación. El idioma de las charlas y los libros se determina por sus títulos originales. Simple AWS es un boletín en inglés; la cifra actual cuenta sus suscripciones activas.'
    };

const cardKinds = ['articles', 'talks', 'books', 'newsletter'] as const;
---

<section
  class="section content-stats"
  id="content-stats"
  aria-labelledby="content-stats-title"
  data-stats-source="/content-stats/v1/current.json"
  data-stats-locale={locale}
>
  <div class="section-shell">
    <div class="section-heading">
      <div class="section-kicker">{copy.kicker}</div>
      <div>
        <h2 id="content-stats-title">{copy.title}</h2>
        <p>{copy.intro}</p>
      </div>
    </div>

    <div class="content-stats-controls">
      <label for="content-stats-language">{copy.filterLabel}</label>
      <select id="content-stats-language" data-stats-language disabled>
        <option value="all" selected>{copy.all}</option>
        <option value="en">{copy.english}</option>
        <option value="es">{copy.spanish}</option>
      </select>
    </div>

    <div class="content-stats-cards">
      {cardKinds.map((kind) => {
        const card = copy.cards[kind];
        return (
          <article class="content-stats-card" data-stats-kind={kind} data-stats-unavailable={card.unavailable} aria-labelledby={`content-stats-${kind}-title`} aria-busy="false">
            <div class="content-stats-card-heading">
              <div>
                <div class="work-kicker">{kind === 'newsletter' ? copy.current : copy.cumulative}</div>
                <h3 id={`content-stats-${kind}-title`}>{card.title}</h3>
              </div>
            </div>

            <p class="content-stats-status" data-stats-status role="status" aria-live="polite" hidden>{card.loading}</p>

            <div class="content-stats-results" data-stats-results hidden>
              <p class="content-stats-count" data-stats-count-region role="status" aria-live="polite" aria-atomic="true">
                <span data-stats-count></span>
                <span data-stats-count-label>{card.unit}</span>
              </p>

              <dl class="content-stats-meta">
                <div>
                  <dt>{copy.coverage}</dt>
                  <dd data-stats-coverage></dd>
                </div>
                <div>
                  <dt>{copy.lastCollected}</dt>
                  <dd data-stats-collected-date></dd>
                </div>
              </dl>

              {kind === 'articles' && <p class="content-stats-reach">{copy.reachUnavailable}</p>}
            </div>
          </article>
        );
      })}
    </div>

    <details class="content-stats-sources">
      <summary>{copy.sourcesSummary}</summary>
      <p>{copy.sourcesExplanation}</p>
    </details>

    <noscript><p class="content-stats-noscript">{copy.noScript}</p></noscript>
  </div>
</section>

<script src="../scripts/content-stats.js"></script>
