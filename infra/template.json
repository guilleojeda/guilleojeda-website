{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private S3 and CloudFront hosting for the Guille Ojeda personal website.",
  "Parameters": {
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing account-level GitHub Actions OIDC provider ARN. Leave empty only when creating one below."
    },
    "CreateOidcProviderIfMissing": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"],
      "Description": "Create the GitHub Actions OIDC provider in this account when no existing ARN is supplied."
    }
  },
  "Rules": {
    "OidcProviderMustBeConfigured": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "GitHubOidcProviderArn"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "CreateOidcProviderIfMissing"
                  },
                  "true"
                ]
              }
            ]
          },
          "AssertDescription": "Pass an existing GitHubOidcProviderArn or explicitly set CreateOidcProviderIfMissing to true in this authorized account."
        }
      ]
    }
  },
  "Conditions": {
    "ShouldCreateOidcProvider": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "GitHubOidcProviderArn"
            },
            ""
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "CreateOidcProviderIfMissing"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "SiteHostedZone": {
      "Type": "AWS::Route53::HostedZone",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "guilleojeda.com.",
        "HostedZoneConfig": {
          "Comment": "Public DNS for guilleojeda.com; registration remains at GoDaddy."
        }
      }
    },
    "SiteApexRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "guilleojeda.com.",
        "Type": "A",
        "TTL": "600",
        "ResourceRecords": [
          "44.218.84.107"
        ]
      }
    },
    "SiteWwwRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "www.guilleojeda.com.",
        "Type": "A",
        "TTL": "600",
        "ResourceRecords": [
          "44.218.84.107"
        ]
      }
    },
    "BlogRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "blog.guilleojeda.com.",
        "Type": "CNAME",
        "TTL": "3600",
        "ResourceRecords": [
          "hashnode.network."
        ]
      }
    },
    "RoadmapIntelligenceRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "roadmapintelligence.guilleojeda.com.",
        "Type": "CNAME",
        "TTL": "3600",
        "ResourceRecords": [
          "d1rx8g6zaejqpb.cloudfront.net."
        ]
      }
    },
    "RoadmapCertificateValidationRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "_66675cb6a658f2ad1f2a908f31c19669.roadmapintelligence.guilleojeda.com.",
        "Type": "CNAME",
        "TTL": "3600",
        "ResourceRecords": [
          "_2ee22fec37a5b8436c15c4ebd6e03d8e.jkddzztszm.acm-validations.aws."
        ]
      }
    },
    "DomainConnectRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "_domainconnect.guilleojeda.com.",
        "Type": "CNAME",
        "TTL": "3600",
        "ResourceRecords": [
          "_domainconnect.gd.domaincontrol.com."
        ]
      }
    },
    "GoogleMailRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "guilleojeda.com.",
        "Type": "MX",
        "TTL": "3600",
        "ResourceRecords": [
          "1 aspmx.l.google.com.",
          "10 alt3.aspmx.l.google.com.",
          "10 alt4.aspmx.l.google.com.",
          "5 alt1.aspmx.l.google.com.",
          "5 alt2.aspmx.l.google.com."
        ]
      }
    },
    "SiteVerificationAndSpfRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "guilleojeda.com.",
        "Type": "TXT",
        "TTL": "3600",
        "ResourceRecords": [
          "\"google-site-verification=2ecdyUNm1Idm6KJLEWLPkkHq2H7CFQRoVbFnP6xMW_M\"",
          "\"google-site-verification=Xl6_0sQP-WFuhCPthzr6Vm_EjG4OGFEy4LtdowuZraY\"",
          "\"v=spf1 include:dc-aa8e722993._spfm.guilleojeda.com ~all\""
        ]
      }
    },
    "GoogleSpfRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "SiteHostedZone"
        },
        "Name": "dc-aa8e722993._spfm.guilleojeda.com.",
        "Type": "TXT",
        "TTL": "3600",
        "ResourceRecords": [
          "\"v=spf1 include:_spf.google.com ~all\""
        ]
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      }
    },
    "SiteOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Description": "SigV4 access from CloudFront to the private site bucket.",
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3-oac"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SiteRouteFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "AutoPublish": true,
        "FunctionCode": "__CLOUDFRONT_FUNCTION_CODE__",
        "FunctionConfig": {
          "Comment": "Language root routing for the static site.",
          "Runtime": "cloudfront-js-2.0"
        },
        "Name": {
          "Fn::Sub": "${AWS::StackName}-routes"
        }
      }
    },
    "SiteCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Comment": "Site content follows origin cache headers, including revalidating HTML.",
          "DefaultTTL": 0,
          "MaxTTL": 31536000,
          "MinTTL": 0,
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site-cache"
          },
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "EnableAcceptEncodingBrotli": true,
            "EnableAcceptEncodingGzip": true,
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "all"
            }
          }
        }
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Comment": "Guille Ojeda personal website Phase 1",
          "DefaultCacheBehavior": {
            "AllowedMethods": ["GET", "HEAD"],
            "CachedMethods": ["GET", "HEAD"],
            "CachePolicyId": {
              "Ref": "SiteCachePolicy"
            },
            "Compress": true,
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SiteRouteFunction",
                    "FunctionARN"
                  ]
                }
              }
            ],
            "TargetOriginId": "SiteOrigin",
            "ViewerProtocolPolicy": "redirect-to-https"
          },
          "DefaultRootObject": "index.html",
          "Enabled": true,
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "Origins": [
            {
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "Id": "SiteOrigin",
              "OriginAccessControlId": {
                "Ref": "SiteOriginAccessControl"
              },
              "S3OriginConfig": {}
            }
          ],
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html"
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html"
            }
          ],
          "Restrictions": {
            "GeoRestriction": {
              "RestrictionType": "none"
            }
          }
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFrontReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "SiteBucket",
                        "Arn"
                      ]
                    },
                    "/*"
                  ]
                ]
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "GitHubOidcProvider": {
      "Condition": "ShouldCreateOidcProvider",
      "Type": "AWS::IAM::OIDCProvider",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ClientIdList": ["sts.amazonaws.com"],
        "Url": "https://token.actions.githubusercontent.com"
      }
    },
    "SiteDeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "ShouldCreateOidcProvider",
                    {
                      "Ref": "GitHubOidcProvider"
                    },
                    {
                      "Ref": "GitHubOidcProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:guilleojeda@18320860/guilleojeda-website@1380340751:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PublishSiteObjectsAndInvalidate",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ListSiteBucket",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "SiteBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "PutSiteObjects",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        {
                          "Fn::GetAtt": [
                            "SiteBucket",
                            "Arn"
                          ]
                        },
                        "/*"
                      ]
                    ]
                  }
                },
                {
                  "Sid": "InvalidateSiteDistribution",
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "HostedZoneId": {
      "Description": "Authoritative public DNS hosted zone.",
      "Value": {
        "Ref": "SiteHostedZone"
      }
    },
    "HostedZoneNameServers": {
      "Description": "Set these four name servers at GoDaddy; registration remains there.",
      "Value": {
        "Fn::Join": [
          ",",
          {
            "Fn::GetAtt": [
              "SiteHostedZone",
              "NameServers"
            ]
          }
        ]
      }
    },
    "BucketName": {
      "Description": "Private bucket receiving the generated site.",
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Description": "CloudFront distribution ID used for invalidations.",
      "Value": {
        "Ref": "SiteDistribution"
      }
    },
    "DistributionDomainName": {
      "Description": "CloudFront HTTPS endpoint for Phase 1.",
      "Value": {
        "Fn::GetAtt": [
          "SiteDistribution",
          "DomainName"
        ]
      }
    },
    "DeploymentRoleArn": {
      "Description": "GitHub Actions OIDC role for site publication.",
      "Value": {
        "Fn::GetAtt": [
          "SiteDeploymentRole",
          "Arn"
        ]
      }
    },
    "DeploymentRoleName": {
      "Description": "Generated deployment role name.",
      "Value": {
        "Ref": "SiteDeploymentRole"
      }
    },
    "GitHubOidcProviderArn": {
      "Description": "OIDC provider used by the deployment role.",
      "Value": {
        "Fn::If": [
          "ShouldCreateOidcProvider",
          {
            "Ref": "GitHubOidcProvider"
          },
          {
            "Ref": "GitHubOidcProviderArn"
          }
        ]
      }
    }
  }
}
